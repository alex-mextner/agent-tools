#!/usr/bin/env bash
# rig-detached-opencode — the canonical rig-owned detached-agent launcher for opencode.
# Usage: rig-detached-opencode <name> <brief-file> [workdir]
#
# A thin wrapper over the shared core in the sibling `rig-detached-agent` universal skill
# (agent-tools#573: one launcher, three harnesses — the child argv is the only difference).
# rig provisions both skills side by side under ~/.agents/skills/ (default skills_target,
# default-on via skills.universal.all), and the core is resolved relative to THIS file's real
# path, so the provisioned copy — ~/.agents/skills/rig-detached-opencode/rig-detached-opencode, the
# path every gate REMINDER names — works whether it is reached directly or through a harness
# skill-dir symlink (~/.codex/skills). See the core for the full contract and trust reasoning.

set -euo pipefail

# Resolve THIS file's real path portably: GNU `readlink -f` first, and on a platform whose
# readlink lacks `-f` (stock BSD/macOS before 12.3) fall back to python3's realpath — python3
# is a hard dependency of the hook family already (review finding, #573 round 1).
self="$(readlink -f -- "$0" 2>/dev/null || python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$0")"
core="$(dirname -- "$self")/../rig-detached-agent/rig-detached-agent"
if [ ! -x "$core" ]; then
    echo "rig-detached-opencode: launcher core '$core' is missing — provision the rig-detached-agent skill (rig apply commit)" >&2
    exit 127
fi
exec "$core" opencode "$@"
