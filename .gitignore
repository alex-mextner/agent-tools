# Runtime caches written by the agent-hooks at run time (never committed).
.cache/
*.done

# Local git worktrees used by parallel agents; never committed.
# Remove with `git worktree remove`, not by deleting source files.
.worktrees/

# OS / editor noise
.DS_Store
*.swp

# Python build / test artifacts (lib/agenttools_log packaging)
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Claude Code personal settings slot (per-machine overrides) — never committed.
.claude/settings.local.json

# Visual proof screenshots / PDFs from agent work — local artifacts, not committed.
*.png
*.pdf
