# Runtime caches written by the agent-hooks at run time (never committed).
.cache/
*.done

# OS / editor noise
.DS_Store
*.swp

# Python build / test artifacts (lib/agenttools_log packaging)
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Per-machine harness settings written by `rig apply` (defaultMode=bypassPermissions).
# Not reproducible across machines — keep untracked. See rig.yaml header note (rig-cli#6).
.claude/settings.json
.claude/settings.local.json
