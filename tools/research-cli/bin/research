#!/usr/bin/env python3
"""research — entry point for research-cli.

A thin shim: put the package root on sys.path (so it runs from a source checkout with no
install step) and hand off to the self-registering dispatcher. Stdlib-only here; the
heavy providers/engine wiring is imported lazily inside the command that needs it.
"""

from __future__ import annotations

import sys
from pathlib import Path

# tools/research-cli/research_cli/cli.py — this file is tools/research-cli/bin/research.
_PKG_ROOT = Path(__file__).resolve().parents[1]
if str(_PKG_ROOT) not in sys.path:
    sys.path.insert(0, str(_PKG_ROOT))

from research_cli.cli import main  # noqa: E402 (after sys.path setup)

if __name__ == "__main__":
    raise SystemExit(main())
