#!/bin/sh
# no-secrets-scan — block committing secrets.
#
# A gitleaks wrapper over the STAGED changes. If gitleaks is installed it runs the real
# scan; if not, it falls back to a small built-in pattern check so the gate still does
# *something* rather than silently passing. Either way, a hit aborts the commit.
#
# Enforces the secret-handling skill and protects against the most expensive mistake —
# a credential in git history (which is effectively permanent once pushed).
#
# Recommended: install gitleaks (https://github.com/gitleaks/gitleaks) for real coverage.
set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if command -v gitleaks >/dev/null 2>&1; then
  # Scan only what's staged for this commit. --redact keeps the secret out of the log.
  if gitleaks protect --staged --redact --no-banner; then
    exit 0
  fi
  echo "no-secrets-scan: gitleaks found a likely secret in the staged changes — aborting." >&2
  echo "  if it's a false positive, allowlist it in .gitleaks.toml; do NOT --no-verify." >&2
  exit 1
fi

# ---- Fallback: minimal built-in scan when gitleaks isn't installed -----------------
echo "no-secrets-scan: gitleaks not found — using a minimal built-in pattern check." >&2
echo "  install gitleaks for proper coverage: https://github.com/gitleaks/gitleaks" >&2

# Patterns kept conservative to limit false positives. Scans the staged diff (added lines).
staged_diff="$(git diff --cached --unified=0 --diff-filter=AM)"

# shellcheck disable=SC2016
hits="$(printf '%s' "$staged_diff" \
  | grep -E '^\+' \
  | grep -Ein \
      -e '-----BEGIN (RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----' \
      -e 'AKIA[0-9A-Z]{16}' \
      -e 'xox[abpsr]-[A-Za-z0-9-]{10,}' \
      -e 'sk-[A-Za-z0-9]{20,}' \
      -e '(api[_-]?key|secret|token|access[_-]?key|client[_-]?secret|password)["'"'"' ]*[:=]["'"'"' ]*[A-Za-z0-9_+/=-]{16,}' \
  | grep -Eiv 'your[_-]?|example|placeholder|dummy|changeme|xxx|<[^>]+>|redacted' \
  || true)"

if [ -n "$hits" ]; then
  echo "no-secrets-scan: likely secret(s) in the staged changes — aborting:" >&2
  printf '%s\n' "$hits" | sed 's/^/  /' >&2
  echo "  move secrets to env / a secret manager; do NOT --no-verify past this." >&2
  exit 1
fi

exit 0
