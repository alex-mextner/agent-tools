#!/bin/sh
# Composing global pre-push hook (core.hooksPath = ~/.config/git/hooks).
#
# Runs the repo-local pre-push gate (if any), then the global-hooks dispatcher for
# the pre-push event. ANY non-zero exit aborts the push.
#
# argv: <remote-name> <remote-url>. The pushed refs arrive on STDIN (one line per
# ref: "<local ref> <local sha> <remote ref> <remote sha>"). Both argv and stdin are
# forwarded to every stage — the dispatcher spools stdin so each hook can read it.
#
# Like the other composers, this only fires for repos that don't override
# core.hooksPath locally; managed repos call the same dispatcher via injection.
HOOK_DIR="$(dirname "$0")"
git_dir="$(git rev-parse --absolute-git-dir 2>/dev/null)" || exit 0
[ -n "$git_dir" ] || exit 0

# Spool stdin so BOTH the repo-local hook and the dispatcher see the pushed refs.
stdin_spool=""
if [ ! -t 0 ]; then
  stdin_spool="$(mktemp "${TMPDIR:-/tmp}/global-prepush-stdin.XXXXXX")" || stdin_spool=""
  [ -n "$stdin_spool" ] && cat > "$stdin_spool"
fi
# Dispatched-marker: exported to stage 1; a NEW run-global-hooks touches it when the
# local hook's chain reaches the runner, so stage 2 knows dispatch already happened.
dispatch_marker="${TMPDIR:-/tmp}/global-hooks-dispatched.pre-push.$$"
rm -f "$dispatch_marker"

cleanup() { [ -n "$stdin_spool" ] && rm -f "$stdin_spool"; rm -f "$dispatch_marker"; }
trap cleanup EXIT INT TERM

feed() {
  if [ -n "$stdin_spool" ]; then "$@" < "$stdin_spool"; else "$@" < /dev/null; fi
}

# --- 1. repo-local pre-push (shadowed by the global hooksPath; run it explicitly).
# A template-shim (init.templateDir) or retrofit-injected local hook CALLS the
# dispatcher itself; if we then ran our own dispatcher stage too, every fragment would
# fire TWICE (duplicate protect-main override-log lines). The marker is a POSITIVE
# runtime signal (the runner touches it when it actually executes) — a shim whose
# runner path is missing leaves it untouched, so stage 2 still dispatches (fail-safe).
local_hook="$git_dir/hooks/pre-push"
# NOTE: `feed` is a FUNCTION — POSIX leaves a prefix assignment's export into a
# function's children unspecified, so use an explicit subshell export instead.
if [ -x "$local_hook" ] && [ "$local_hook" != "$0" ]; then
  ( export GLOBAL_HOOKS_DISPATCH_MARKER="$dispatch_marker"; feed "$local_hook" "$@" ) || exit $?
fi

# --- 2. global-hooks dispatcher (pre-push event) — unless stage 1 provably dispatched.
# The marker env is UNSET here so a nested composer chain can't touch OUR marker.
if [ ! -e "$dispatch_marker" ] && [ -x "$HOOK_DIR/../run-global-hooks" ]; then
  ( unset GLOBAL_HOOKS_DISPATCH_MARKER; feed "$HOOK_DIR/../run-global-hooks" pre-push "$@" ) || exit $?
fi

exit 0
