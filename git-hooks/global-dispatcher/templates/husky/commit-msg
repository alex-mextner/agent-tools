#!/bin/sh
# .husky/commit-msg TEMPLATE — preseeded with the global git-hook dispatcher.
# $1 is the path to the proposed commit-message file; forward it to the dispatcher.
# Put your repo's own commit-msg checks above the dispatcher line.

# global-git-hooks-dispatcher — runs every global hook for this event (see agent-tools git-hooks/global-dispatcher)
"${XDG_CONFIG_HOME:-$HOME/.config}/git/run-global-hooks" commit-msg "$1" || exit $?
